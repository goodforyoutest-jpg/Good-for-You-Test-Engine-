rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── USERS ─────────────────────────────────────────────────────────
    // Users can read and write their own document.
    // Admins can read all users.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── TESTS ─────────────────────────────────────────────────────────
    // Any signed-in user can read active tests. `tests/{id}.questions`
    // holds ONLY question text/options/passage/image — never the
    // correct answer or explanation. Those live in testAnswers/{id}
    // (below), which students can never read.
    // Only admins can create/update/delete tests.
    match /tests/{testId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── TEST ANSWERS ─────────────────────────────────────────────────
    // The correct-answer key for a test. Deliberately kept in its own
    // document, separate from /tests/{id}, so that reading a test to
    // display its questions can NEVER also hand over the answer key.
    // Admins can read/write it (test authoring, preview). Everyone
    // else is denied — even the grading Netlify Functions don't need
    // an explicit allow here, since they use the Admin SDK, which
    // bypasses these rules entirely.
    match /testAnswers/{testId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── ATTEMPTS ─────────────────────────────────────────────────────
    // One doc per (test, user): `{testId}_{uid}`. Created and graded
    // ONLY by the start-test / submit-test Netlify Functions (Admin
    // SDK, bypasses these rules) — that's what keeps `answerKeyOrder`,
    // the frozen marking scheme, and `status`/`resultId` tamper-proof.
    // The client is only ever trusted to autosave its own progress:
    // which option it picked, which question it's on, and the
    // anti-cheat counters — nothing that affects how it gets graded.
    match /attempts/{attemptId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['answered', 'currentQ', 'tabSwitchCount', 'cheatLog', 'lastSavedAt']);
      allow create, delete: if false;
    }

    // ── RESULTS ───────────────────────────────────────────────────────
    // Users can read their own results; admins can read all.
    // Direct client-side creation is allowed ONLY for self-graded
    // practice tests (testId == null — see test-own.html, which has no
    // server-held answer key to protect in the first place). Results
    // for a real, live test (testId != null) can only be created by
    // submit-test.js via the Admin SDK — a signed-in client can no
    // longer write itself a fake score by calling Firestore directly.
    match /results/{resultId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.testId == null;
      allow update: if isAdmin() ||
        // Allow updating rank field only
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rank']));
      allow delete: if isAdmin();
    }

    // ── ANALYTICS (optional collection) ───────────────────────────────
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
