rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organisations — public read/write for backend API org creation
    match /organisations/{orgCode} {
      allow read: if true;
      allow write: if true;
    }

    // Users — public write for backend account creation, auth required to read
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Tests — same-org users can read, admins can write.
    // The dashboard query includes orgCode so Firestore can validate it.
    match /tests/{testId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode;
      allow write: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    // Explicit answer-key lock for live-test grading.
    match /testAnswers/{testId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Results — users can read their own results; admins can read org results.
    // This preserves the old org behavior while allowing the dashboard's
    // userId query to work reliably.
    match /results/{resultId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode
      );
      allow write: if request.auth != null;
    }

    // Notes — unchanged.
    match /notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Everything else — authenticated only, except answer keys are governed
    // by the explicit rule above.
    match /{document=**} {
      allow read, write: if request.auth != null &&
        !document.matches('testAnswers/[^/]+');
    }
  }
}
