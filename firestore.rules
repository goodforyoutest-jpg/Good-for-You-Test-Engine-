rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organisations — unchanged
    match /organisations/{orgCode} {
      allow read: if true;
      allow write: if true;
    }

    // Users — unchanged
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Tests — same organisation users can read.
    // Admin and super_admin users can write.
    match /tests/{testId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode;

      allow write: if request.auth != null &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
    }

    // Correct-answer keys.
    // Students must never be able to read these.
    // Netlify Admin SDK functions bypass Firestore rules.
    match /testAnswers/{testId} {
      allow read: if request.auth != null &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );

      allow write: if request.auth != null &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
    }

    // Results — unchanged behavior.
    match /results/{resultId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode;

      allow write: if request.auth != null;
    }

    // Notes — unchanged.
    match /notes/{noteId} {
      allow read: if true;

      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    /*
      Everything else — authenticated users only.

      The exclusion for testAnswers is required because Firestore
      allow rules are additive. Without this exclusion, this broad
      rule would allow any signed-in student to read testAnswers,
      even when the specific testAnswers rule denies access.
    */
    match /{document=**} {
      allow read, write: if request.auth != null &&
        !document.matches('testAnswers/[^/]+');
    }
  }
}
