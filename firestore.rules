rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Organisations — public read/write for backend API org creation
    match /organisations/{orgCode} {
      allow read: if true;
      allow write: if true;
    }

    // Users — public write for backend account creation, auth required to read
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Tests — same org users can read, teachers and admins can write
    match /tests/{testId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode;
      allow write: if request.auth != null &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
    }

    // Explicit answer-key lock for live-test grading.
    // This keeps the exact answer key from the broad catch-all below.
    match /testAnswers/{testId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
      allow write: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Results — same org users can read, any authenticated user can write
    match /results/{resultId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgCode ==
        resource.data.orgCode;
      allow write: if request.auth != null;
    }

    // Notes — public read (native PDF links, no login required), writes restricted to super admin only
    match /notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Everything else — authenticated only
    // Important: this is deliberately broad but does not include testAnswers,
    // because the explicit testAnswers rule above is more specific and must win.
    match /{document=**} {
      allow read, write: if request.auth != null &&
        !document.matches('testAnswers/[^/]+');
    }

  }
}
